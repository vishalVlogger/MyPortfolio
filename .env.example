# Copy to .env.local to use your published portfolio as the content source.
# Leave unset only when intentionally using an isolated local database.
PORTFOLIO_REMOTE_ORIGIN=https://myportfolio.thepatilvishal.workers.dev
# Required for editing: 32 random bytes encoded as 64 lowercase hex characters.
# Must match the hosted PORTFOLIO_SYNC_KEY secret. Never use a VITE_ prefix or
# expose this value in client code. Without it, all write access remains locked.
PORTFOLIO_SYNC_KEY=
