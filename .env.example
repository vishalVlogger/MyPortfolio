# Copy to .env.local to use your published portfolio as the content source.
# Leave unset only when intentionally using an isolated local database.
PORTFOLIO_REMOTE_ORIGIN=https://portfoliostudio.vishal-patil362000.chatgpt.site
# Optional: 32 random bytes encoded as 64 lowercase hex characters.
# Must match the hosted PORTFOLIO_SYNC_KEY secret. Never use a VITE_ prefix.
PORTFOLIO_SYNC_KEY=
